# токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# прокси до api.telegram.org, нужен только если с сервера телега напрямую не открывается
# вид: socks5://host:port, socks5://user:pass@host:port или http://host:port
TELEGRAM_PROXY=

# Yandex Cloud: API-ключ сервисного аккаунта и ID каталога
# без них бот работает на правилах: без голоса и без поиска по смыслу
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_LLM_MODEL=aliceai-llm/latest
YANDEX_TTS_VOICE=alena

# часовой пояс, время утренней сводки, длина встречи по умолчанию (мин),
# за сколько минут напоминать о встрече, порог поиска по смыслу (от 0 до 1)
TIMEZONE=Europe/Moscow
DIGEST_TIME=09:00
MEETING_MINUTES=60
MEETING_REMINDER_MINUTES=15
SEMANTIC_THRESHOLD=0.55
